# NO SUS — Environment Configuration
# Copy this file to .env and fill in your values.
#
# Usage with Flutter:
#   flutter run --dart-define=SUPABASE_URL=your_url --dart-define=SUPABASE_ANON_KEY=your_key
#
# Leave empty to run in mock fallback mode (no Supabase needed).

# --- Required (leave empty for mock mode) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Google Drive Proxy (legacy — optional) ---
# These are only needed if you deploy the drive-proxy Edge Function.
SUPABASE_SERVICE_ROLE_KEY=
GD_SERVICE_ACCOUNT_EMAIL=
GD_PRIVATE_KEY=
GD_PARENT_FOLDER_ID=
